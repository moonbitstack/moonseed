// The page's door into the library: the crate compiled to wasm (WASI), with a
// few functions exported to JavaScript. The page pushes the bytes it gathered
// into a `Replay`, draws its tile through `below`, and counts the same replay
// twice for the plots. The WASI build asks the host for one thing only —
// `fd_write` — which the page stubs out; it never asks for `random_get`,
// because the bytes come from the page.
pkgtype(kind: "executable")

import {
  "moonbitstack/moonseed",
}

options(
  link: {
    "wasm-gc": {
      "exports": [
        "reset",
        "push",
        "taken",
        "open",
        "unit",
        "below_hits",
        "mod_hits",
        "trace",
        "trace_width",
        "trace_mask",
        "trace_attempts",
        "trace_value",
        "trace_byte",
        "scalar_draw",
        "scalar_len",
        "scalar_byte",
      ],
    },
    "wasm": {
      "exports": [
        "reset",
        "push",
        "taken",
        "open",
        "unit",
        "below_hits",
        "mod_hits",
        "trace",
        "trace_width",
        "trace_mask",
        "trace_attempts",
        "trace_value",
        "trace_byte",
        "scalar_draw",
        "scalar_len",
        "scalar_byte",
      ],
    },
  },
)

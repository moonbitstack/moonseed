///|
test "below returns what the JDK's draw returns, from the same bytes" {
  for v in jdk_below_vectors {
    let (bound, stream, values) = v
    let source = @moonseed.Replay::new(stream)
    for value in values {
      assert_eq(@moonseed.below(bound, source), value)
    }
    assert_eq(source.remaining(), 0)
  }
}

///|
test "scalar returns the scalar the JDK's draw makes, from the same bytes" {
  for v in jdk_scalar_vectors {
    let (order, stream, key) = v
    let source = @moonseed.Replay::new(stream)
    assert_eq(@moonseed.scalar(order, source), key)
    assert_eq(source.remaining(), 0)
  }
}
